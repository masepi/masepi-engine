# Название сайта для <title>, Open Graph и других HTML-метаданных.
# Значение обязательно и относится только к конкретному экземпляру сайта.
SITE_TITLE="Example site"

# Язык содержимого в формате BCP 47 для атрибута <html lang="...">.
# Примеры: ru, en, de, ru-RU. Значение обязательно.
SITE_LANGUAGE="en"

# Публичное DNS-имя без протокола, пути и завершающего слеша.
# nginx использует его в server_name и при выводе инструкции для webhook.
SITE_DOMAIN="example.com"

# Полный канонический HTTPS-адрес сайта без завершающего слеша.
# Используется в canonical URL, Open Graph, sitemap.xml и robots.txt.
BASE_URL="https://example.com"

# Ветка content-репозитория, которую разрешено публиковать.
# Webhook для push в другие ветки не запускает сборку.
CONTENT_BRANCH="main"

# Идентификатор GitHub-репозитория строго в формате owner/repository.
# Из него автоматически строится SSH URL git@github.com:owner/repository.git;
# publisher также сверяет значение с repository.full_name в webhook payload.
WEBHOOK_REPOSITORY="OWNER/CONTENT_REPOSITORY"

# Общий секрет GitHub webhook и publisher для проверки HMAC-SHA256.
# Оставьте пустым: install.sh сгенерирует случайное значение и допишет его сюда.
WEBHOOK_SECRET=""

# Интервал резервной проверки Git на случай потерянного webhook.
# Формат Go duration: 30s, 5m, 1h. Минимальное значение — 5s.
POLL_INTERVAL="5m"

# Абсолютный путь на хосте к общему корню сертификатов и ключей.
# Каталог целиком монтируется в nginx read-only, чтобы сохранялись symlink’и Certbot.
TLS_CERT_DIR="/etc/letsencrypt"

# Путь к полной цепочке сертификата относительно TLS_CERT_DIR.
# Для Certbot обычно используется live/DOMAIN/fullchain.pem.
TLS_CERT_FILE="live/example.com/fullchain.pem"

# Путь к приватному ключу относительно TLS_CERT_DIR.
# Для Certbot обычно используется live/DOMAIN/privkey.pem.
TLS_KEY_FILE="live/example.com/privkey.pem"
